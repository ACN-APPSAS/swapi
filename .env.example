# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to version control.

# ── Required ───────────────────────────────────────────────────────────────────

# Django secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────

# Set to True only in local development (enables debug pages, uses SQLite)
DEBUG=False

# Comma-separated list of hostnames the app is allowed to serve
# Example: ALLOWED_HOSTS=swapi.example.com,www.swapi.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Number of gunicorn worker processes (default: 4)
GUNICORN_WORKERS=4

# Set to true to seed Star Wars data on the first container start
LOAD_FIXTURES=false

# ── Database ───────────────────────────────────────────────────────────────────
# Used by docker-compose to set the postgres container password and build
# the DATABASE_URL connection string for the web service.
DB_PASSWORD=changeme

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=

# ── Keen.io analytics (optional) ──────────────────────────────────────────────
KEEN_PROJECT_ID=
KEEN_WRITE_KEY=
KEEN_READ_KEY=
